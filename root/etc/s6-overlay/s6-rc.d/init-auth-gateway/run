#!/usr/bin/with-contenv bash

set -euo pipefail

auth_username="${AUTH_USERNAME:-admin}"
auth_password="${AUTH_PASSWORD:-}"
nginx_config="${AUTH_GATEWAY_NGINX_CONFIG:-/etc/nginx/sites-available/default}"
htpasswd_file="${AUTH_GATEWAY_HTPASSWD_FILE:-/etc/nginx/.htpasswd}"

if [[ -z "${auth_password}" ]]; then
  echo "[Auth] AUTH_PASSWORD is required" >&2
  exit 1
fi

# nginx htpasswd 的用户名字段不能包含分隔符或换行。
if [[ "${auth_username}" == *:* || "${auth_username}" == *$'\r'* || "${auth_username}" == *$'\n'* ]]; then
  echo "[Auth] AUTH_USERNAME cannot contain colon or newline characters" >&2
  exit 1
fi
if [[ "${auth_password}" == *$'\r'* || "${auth_password}" == *$'\n'* ]]; then
  echo "[Auth] AUTH_PASSWORD cannot contain newline characters" >&2
  exit 1
fi

# init-nginx 已生成配置；这里为两个 server 块启用入口 Basic Auth。
password_hash="$(openssl passwd -apr1 -- "${auth_password}")"
printf '%s:%s\n' "${auth_username}" "${password_hash}" > "${htpasswd_file}"
sed -i '/#auth_basic/s/#//' "${nginx_config}"

if command -v nginx >/dev/null 2>&1; then
  nginx -t
fi

echo "[Auth] Selkies gateway authentication enabled for ${auth_username}"
